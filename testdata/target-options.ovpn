################################################################################
# OpenVPN client configuration in the target profile's shape                   #
################################################################################
# The target profile's client configuration, with documentation addresses
# and relative key paths.

client
dev tun0
daemon
writepid /var/run/openvpn.pid
resolv-retry infinite
nobind
mute-replay-warnings

ca   keys/ca.crt
cert keys/client.crt
key  keys/client.key

;tls-auth ta.key 1
;cipher x

comp-lzo no
comp-noadapt
passtos
txqueuelen 1000
fast-io
socket-flags TCP_NODELAY
tcp-queue-limit 192
verb 2
log-append /var/log/openvpn.log
tls-client
mute 20

tun-mtu 1450
mssfix 1410

remote-cert-tls server

connect-timeout 20
connect-retry 5 60

<connection>
remote 192.0.2.48 1181 udp
</connection>
<connection>
remote 198.51.100.147 1193 udp
</connection>
<connection>
remote 198.51.100.147 1181 udp
</connection>
